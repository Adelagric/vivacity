{
    "name": "vivacity/scripts-fixture",
    "description": "install-time scripts: order, dev mode, callables, aliases, exit codes",
    "type": "project",
    "license": "MIT",
    "version": "1.0.0",
    "require": {
        "psr/log": "^3.0"
    },
    "require-dev": {
        "psr/container": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "log": "@php scripts/log.php",
        "pre-install-cmd": "@log pre-install-cmd",
        "pre-autoload-dump": [
            "@log pre-autoload-dump"
        ],
        "post-autoload-dump": [
            "App\\Hooks::postAutoloadDump",
            "@log post-autoload-dump"
        ],
        "post-install-cmd": [
            "@log post-install-cmd",
            "App\\Hooks::postInstall"
        ]
    }
}
