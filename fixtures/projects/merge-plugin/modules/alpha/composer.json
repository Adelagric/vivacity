{
    "name": "vivacity/alpha-module",
    "require": {
        "monolog/monolog": "^3.5 || ^2.9",
        "psr/log": "^3.0",
        "symfony/polyfill-ctype": "^1.30",
        "vivacity/alpha-compat": "self.version"
    },
    "require-dev": {
        "psr/http-message": "^2.0"
    },
    "autoload": {
        "psr-4": {"App\\": "src/", "Alpha\\": "lib/"},
        "files": ["src/alpha_boot.php"],
        "exclude-from-classmap": ["tests/"]
    },
    "autoload-dev": {
        "psr-4": {"AlphaTests\\": "tests/"}
    },
    "provide": {
        "vivacity/alpha-feature": "1.0"
    },
    "replace": {
        "vivacity/alpha-compat": "self.version"
    },
    "conflict": {
        "acme/nowhere": "<2.0",
        "acme/elsewhere": "*"
    },
    "extra": {
        "merge-plugin": {"include": ["nested/composer.json"]},
        "alpha-only": true
    }
}
